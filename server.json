{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jamesafful/anthromesh",
  "title": "AnthroMesh",
  "description": "Local preference memory, owner escalation, and verifiable delegation for agents.",
  "repository": {
    "url": "https://github.com/jamesafful/AnthroMesh",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "anthromesh",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve-mcp"
        },
        {
          "type": "named",
          "name": "--transport",
          "value": "stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "ANTHROMESH_MEMORY_ONLY",
          "description": "Use verified exact memory and owner escalation.",
          "value": "1"
        }
      ],
      "runtimeHint": "uvx"
    }
  ]
}
