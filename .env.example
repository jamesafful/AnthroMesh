# AnthroMesh Configuration
ANTHROMESH_DB_PATH=./anthromesh_vault.db
ANTHROMESH_POLICY_PATH=./examples/sample_policies.yaml
# ANTHROMESH_ORGANIZATION_POLICY_PATH=./organization-policy.json
# ANTHROMESH_JUDGMENT_MONITOR=1
ANTHROMESH_CONFIDENCE_THRESHOLD=0.72
ANTHROMESH_MIN_EVIDENCE_COUNT=2

# Inference Adapter Selection: heuristic | ollama | vllm | openai | anthropic | gemini
ANTHROMESH_ADAPTER=heuristic
ANTHROMESH_MODEL=llama3.2

# Local Model Runners
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Cloud API Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Protocol Servers
ANTHROMESH_MCP_HOST=127.0.0.1
ANTHROMESH_MCP_PORT=8081
ANTHROMESH_A2A_HOST=127.0.0.1
ANTHROMESH_A2A_PORT=8082

# Optional. Set in your secret manager or process environment.
# ANTHROMESH_VAULT_KEY=
# ANTHROMESH_EMBEDDING_MODEL=nomic-embed-text

# ANTHROMESH_CALIBRATION_PATH=
# ANTHROMESH_OAUTH_ISSUER=
# ANTHROMESH_OAUTH_RESOURCE=
# ANTHROMESH_OAUTH_JWKS=
# ANTHROMESH_GITHUB_WEBHOOK_SECRET=
# ANTHROMESH_INBOX_PASSWORD=

# Route all exact-memory misses to the owner without model inference.
# ANTHROMESH_MEMORY_ONLY=1
